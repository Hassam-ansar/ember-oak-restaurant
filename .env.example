# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# MongoDB Connection URI (Supports local MongoDB or MongoDB Atlas cluster URI)
# When omitted in preview/development, the server automatically persists to an embedded JSON-backed Mongoose adapter so all CRUD operations work out of the box.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ember_oak_restaurant?retryWrites=true&w=majority"

# JWT Authentication Secret
JWT_SECRET="ember_oak_super_secret_jwt_signing_key_2026"
JWT_EXPIRES_IN="7d"

# Cloudinary Configuration (for product & banner image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Data Mode: "demo" seeds sample products, inventory, staff, and sample orders on first boot; "production" starts clean
DATA_MODE="demo"
